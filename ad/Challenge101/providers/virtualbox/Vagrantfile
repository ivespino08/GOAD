# ad/Challenge101/providers/virtualbox/Vagrantfile
#
# Box swapped generic/ubuntu2204 -> bento/ubuntu-22.04, same version
# PROVISIONING already runs (202401.31.0). Validated end-to-end on
# Challenge130 first (same 5-router non-uniform mesh shape, router-1 hub
# with r2r degree 4, RIP, persist_boot_commands-based LAN/gateway
# addressing, network/traffic — all confirmed working, including full
# reboot-survival testing) before rolling out to this scenario.
#
# Two things fixed alongside the box swap, both pre-existing and unrelated
# to bento specifically:
#   1. The default-route task previously lived in topology-services.yml and
#      ran BEFORE topology-docker.yml's real apt-based docker-ce install
#      (docker/vuln_node adds Docker's apt repo over HTTPS and installs
#      docker-ce/docker-ce-cli) — same route-hijack-before-a-pending-apt-
#      install bug diagnosed for Challenge78, just hidden behind a
#      misleadingly-named file here. Moved to its own topology-gateway.yml,
#      now run last, matching the Challenge130/Challenge70 fix.
#   2. This scenario had no VirtualBox provider at all (every other
#      scenario has one) — added, mirroring this file.
#
# router-1 has r2r degree 4 (6 total adapters: NAT + mgmt + 4 r2r links) —
# same PCI-bridge slot overflow trigger seen on Challenge101/Challenge78 and
# confirmed to reproduce identically on bento (Challenge130's router-1 hit
# the exact same guest-eth-naming scramble). Not a new risk from this swap:
# network/resolve_iface_roles + fix_router_netplan.py already resolve it
# automatically via MAC-based reassignment (confirmed working on bento,
# zero code changes needed). If router-1 is unreachable via plain `ssh`
# while `vagrant ssh router-1` still works, that's this exact signature —
# check /etc/goad/iface-roles.env on router-1 rather than reaching for a
# manual fix.
#
# Same substitution mechanism as Scenario3's: GOAD drops this file's
# content into template/provider/virtualbox/Vagrantfile's "lab" placeholder
# (written here without literal double-curly-brace syntax deliberately —
# this file is itself Jinja2-rendered by goad.py before Vagrant ever sees
# it, so writing the literal placeholder syntax in a comment here would
# have gotten it evaluated as a real, likely-undefined Jinja expression
# instead of staying inert documentation text).
#
# :networks order matches this scenario's config.json r2r_interfaces key
# order EXACTLY, per router, since topology-routers.yml/topology-links.yml
# use peer_idx+2 (i.e. r2r_interfaces.keys() index) for interface naming:
#   router-1 config.json r2r_interfaces order: router-4, router-3, router-5, router-2
#     -> :networks: [172.18.244.1, 10.0.245.1, 172.17.254.1, 192.168.103.1]
#   router-2 order: router-4, router-1
#     -> :networks: [192.168.78.1, 192.168.103.2]
#   router-3 order: router-1, router-5
#     -> :networks: [10.0.245.2, 10.0.132.1]
#   router-4 order: router-2, router-1
#     -> :networks: [192.168.78.2, 172.18.244.2]
#   router-5 order: router-1, router-3
#     -> :networks: [172.17.254.2, 10.0.132.2]
# If you ever reorder keys in config.json's r2r_interfaces for any router,
# update the matching :networks list here in the same order — they are
# NOT derived from each other automatically, same as Scenario3.
#
# router-5 has no LAN/switch in this scenario (see config.json's _note on
# router-5) but still gets the same box shape as every other router —
# it just isn't anyone's gateway.

boxes = [
  { :name => "router-1", :ip => "192.168.57.11", :box => "bento/ubuntu-22.04", :box_version => "202401.31.0", :os => "linux", :cpus => 1, :mem => 2048,
    :networks => ["172.18.244.1", "10.0.245.1", "172.17.254.1", "192.168.103.1"] },
  { :name => "router-2", :ip => "192.168.57.12", :box => "bento/ubuntu-22.04", :box_version => "202401.31.0", :os => "linux", :cpus => 1, :mem => 2048,
    :networks => ["192.168.78.1", "192.168.103.2"] },
  { :name => "router-3", :ip => "192.168.57.13", :box => "bento/ubuntu-22.04", :box_version => "202401.31.0", :os => "linux", :cpus => 1, :mem => 2048,
    :networks => ["10.0.245.2", "10.0.132.1"] },
  { :name => "router-4", :ip => "192.168.57.14", :box => "bento/ubuntu-22.04", :box_version => "202401.31.0", :os => "linux", :cpus => 1, :mem => 2048,
    :networks => ["192.168.78.2", "172.18.244.2"] },
  { :name => "router-5", :ip => "192.168.57.15", :box => "bento/ubuntu-22.04", :box_version => "202401.31.0", :os => "linux", :cpus => 1, :mem => 2048,
    :networks => ["172.17.254.2", "10.0.132.2"] },

  { :name => "pc-3",     :ip => "192.168.57.23", :box => "bento/ubuntu-22.04", :box_version => "202401.31.0", :os => "linux", :cpus => 1, :mem => 2048 },
  { :name => "server-4", :ip => "192.168.57.24", :box => "bento/ubuntu-22.04", :box_version => "202401.31.0", :os => "linux", :cpus => 1, :mem => 2048 },

  { :name => "docker-1", :ip => "192.168.57.31", :box => "bento/ubuntu-22.04", :box_version => "202401.31.0", :os => "linux", :cpus => 1, :mem => 2048 },
  # docker-2 runs the Airflow CeleryExecutor stack (postgres + redis +
  # webserver + scheduler + worker) — vulhub's own README for this CVE
  # says to "prepare more than 2G of memory for the use of the virtual
  # machine." Bumped accordingly; same reasoning Scenario3 used to bump
  # attacker-1's resources for its own workload.
  { :name => "docker-2", :ip => "192.168.57.32", :box => "bento/ubuntu-22.04", :box_version => "202401.31.0", :os => "linux", :cpus => 2, :mem => 4096 },
]

Vagrant.configure("2") do |config|
  config.ssh.insert_key = false
end
