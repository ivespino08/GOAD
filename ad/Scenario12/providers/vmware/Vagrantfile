# Scenario12 -- single-host Docker "LAN" (trimmed from 10 hosts to the one
# that actually carries a vuln), no routers.
# Per the existing topology-hosts.yml convention, the host's LAN IP
# (172.23.255.x) is added as a *secondary* address on the same eth1 that
# carries the management IP below -- not a dedicated adapter. That means
# this scenario needs zero extra vmnets beyond the one shared management
# network every GOAD scenario already uses.
#
# TRIMMED (this session): docker-1 through docker-5 and docker-7 through
# docker-10 removed -- they carried no vulns and weren't referenced by any
# r2r_link/traffic entry (config.json's lists were already empty), so
# removal here is just deleting their box entries. docker-6 kept its
# original IP (192.168.57.16) rather than being renumbered to .11, since
# renumbering buys nothing here and only risks a stray typo somewhere else
# still referencing .16.

boxes = [
  { :name => "docker-6", :ip => "192.168.57.16", :box => "generic/ubuntu2204",
    :box_version => "4.3.12", :os => "linux", :cpus => 1, :mem => 2048 },
]

Vagrant.configure("2") do |config|
  config.ssh.insert_key = false
end
